frontend/certs/

# Build output for a Hosted Test upload. Regenerate with:
#   cd frontend && npm run build   (then zip dist/ contents at the zip root)
extension-hosted-test.zip

# Built by scripts/build_cdn.py and uploaded to the card host; never committed.
cdn-out/
